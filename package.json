{
  "name": "build",
  "version": "1.0.0",
  "private": true,
  "description": "Build - Online Study Rooms App",
  "scripts": {
    "dev": "node init && pnpm -r --parallel dev",
    "dev:client": "node init && pnpm --filter client dev",
    "dev:server": "node init && pnpm --filter server dev",
    "build": "node init && pnpm -r build",
    "build:client": "node init && pnpm --filter client build",
    "build:server": "node init && pnpm --filter server build",
    "start": "node init && pnpm --filter server start",
    "install:all": "pnpm install"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
